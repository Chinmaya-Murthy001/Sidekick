# Optional. With a key, Claude decides what to do; without one, the offline planner runs.
ANTHROPIC_API_KEY=
# auto | claude | rules
SIDEKICK_AGENT=auto
SIDEKICK_MODEL=claude-opus-5-5
SIDEKICK_EFFORT=low

# Optional: send a real bot into a Google Meet call through Recall.ai.
RECALL_API_KEY=
RECALL_REGION=us-east-1

PORT=8000
