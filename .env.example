# --- AI agent (pick one; without any key the offline planner runs) ---
# OpenRouter: one key for many models, Claude included. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-capable model id from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Or Anthropic directly: https://console.anthropic.com
ANTHROPIC_API_KEY=
SIDEKICK_MODEL=claude-opus-5-5
SIDEKICK_EFFORT=low

# auto (OpenRouter, then Anthropic, then offline) | openrouter | claude | rules
SIDEKICK_AGENT=auto

# --- Google Calendar + Gmail ---
# Put the OAuth client JSON at data/google_client_secret.json (or give its path here),
# then click "Connect" next to Google on the start screen.
GOOGLE_CLIENT_SECRET_FILE=

# --- Optional: Sidekick joins Meet/Zoom/Teams links itself (Recall.ai) ---
# PUBLIC_URL must reach this server from the internet (e.g. an ngrok URL).
RECALL_API_KEY=
RECALL_REGION=us-east-1
PUBLIC_URL=

# --- Local storage ---
SIDEKICK_DATA=
PORT=8000
