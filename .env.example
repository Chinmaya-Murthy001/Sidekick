# Optional. With a key, Claude decides what to do; without one, the offline planner runs.
ANTHROPIC_API_KEY=
# auto | claude | rules
SIDEKICK_AGENT=auto
SIDEKICK_MODEL=claude-opus-5-5
SIDEKICK_EFFORT=low

# Google Calendar + Gmail: put the OAuth client JSON at data/google_client_secret.json,
# or point to it here, then click "Connect Google" in the app.
GOOGLE_CLIENT_SECRET_FILE=

# Optional: let Sidekick send its own bot into a Google Meet link through Recall.ai.
# PUBLIC_URL must reach this server from the internet (e.g. an ngrok URL).
RECALL_API_KEY=
RECALL_REGION=us-east-1
PUBLIC_URL=

# Where the meeting archive and Google token live.
SIDEKICK_DATA=
PORT=8000
